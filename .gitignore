# corpus text: committed only in the private burner repo. Ignored here so the public repo never re-adds it;
# already-tracked files in the burner are unaffected (new corpus files there need git add -f). Raw PDFs stay local (size).
docs/research/**/corpus/
docs/research/**/corpus/pdf/*.pdf
*.pdf
# data and kernels (root only: web/public/data/ holds the shipped files and must be tracked)
/data/
*.TIF
*.tif
*.bsp
*.bpc
*.epa
# secrets and local config
.env
.claude/settings.local.json
.claude/scheduled_tasks.lock
# build output
target/
node_modules/
dist/

# generated by `bun run wasm`
web/src/lib/wasm/
# playwright output
test-results/
playwright-report/
